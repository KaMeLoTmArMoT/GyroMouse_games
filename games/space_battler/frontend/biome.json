{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": false,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "off",
        "noNonNullAssertion": "warn"
      },
      "a11y": {
        "recommended": false
      }
    }
  }
}

